# 官方 API 线（可选——不配置时对应适配器自动禁用，其余源照常工作）
# TMDB 免费 key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb 免费 key（1000次/天，补 IMDb 评分/Metascore）: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# WhatIsMyMovie Beta key（自然语言找片）: https://whatismymovie.com/apiguide/
WIMM_API_KEY=
# WIMM_API_URL=https://whatismymovie.com/api/v1/search

# Yandex 官方 Search API（多语言发现通道的稳定模式，不配则走网页爬取模式）
# https://yandex.ru/dev/search/api/ 免费额度 1000 次/月
YANDEX_API_KEY=
YANDEX_XML_USER=

# 爬虫适配器走代理（IMDb/Letterboxd/Yandex 对数据中心 IP 反爬严格时使用）
# HTTP_PROXY=http://127.0.0.1:7890
